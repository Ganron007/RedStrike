# Copy to .env in this directory. Never commit .env.
# Generate an API key: python -c "import secrets; print(secrets.token_urlsafe(32))"

# REDSTRIKE_API_KEY=
# REDSTRIKE_WINDOWS_HOST=
# REDSTRIKE_WINDOWS_USER=
# REDSTRIKE_WINDOWS_SSH_KEY=
# REDSTRIKE_WINDOWS_TOOLS_DIR=
# REDSTRIKE_WINDOWS_KNOWN_HOSTS=
# REDSTRIKE_WINDOWS_SSH=1
# REDSTRIKE_OPERATOR=
# REDSTRIKE_SEED=
# REDSTRIKE_AUTOMATION_ROOT=

# --- C2Stack integration (optional; only needed for --c2 runs) ---
# Flight Control portal base URL for the havoc/adaptix backends (default below)
# C2STACK_PORTAL_URL=http://127.0.0.1:8000
# Mythic REST credentials (--c2-backend mythic; endpoint http://127.0.0.1:7443)
# MYTHIC_API_KEY=
# MYTHIC_USERNAME=mythic_admin
# MYTHIC_PASSWORD=
# Meridian operator token, if set on the teamserver (--c2-backend meridian)
# MERIDIAN_API_KEY=
